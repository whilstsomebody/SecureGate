  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Gateway Traffic & Status",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "auto" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "expr": "sum by (path, status) (rate(securegate_requests_total[1m]))",
          "legendFormat": "{{path}} [{{status}}]"
        }
      ],
      "title": "Request Rate by Route & Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(securegate_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "Total p99"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(securegate_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "Total p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(securegate_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "Total p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(securegate_upstream_duration_seconds_bucket[1m])) by (le, route))",
          "legendFormat": "Upstream {{route}} p95"
        }
      ],
      "title": "Latency Percentiles (Total & Upstream)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
